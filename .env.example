# Database connection (Use PostgreSQL in production or SQLite in local dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gharkatiffin?schema=public"

# JWT Auth Secret
JWT_SECRET="your-jwt-secret-key-at-least-32-chars-long"

# Public App Config
NEXT_PUBLIC_APP_NAME="GharKaTiffin"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Service Abstraction Drivers: 'mock' | 's3' | 'google' | 'razorpay'
STORAGE_DRIVER="mock"
MAPS_DRIVER="mock"
PAYMENT_DRIVER="mock"
NOTIFICATION_DRIVER="mock"

# Cloud Credentials
STORAGE_URL="https://s3.ap-south-1.amazonaws.com/your-bucket"
MAPS_API_KEY="AIzaSyYourGoogleMapsApiKey"
PAYMENT_API_KEY="rzp_live_yourRazorpayKey"
PAYMENT_API_SECRET="yourRazorpaySecret"
EMAIL_API_KEY="sg_yourSendgridApiKey"
SMS_API_KEY="tw_yourTwilioApiKey"
REDIS_URL="redis://localhost:6379"
