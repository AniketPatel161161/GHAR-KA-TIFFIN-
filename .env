# Database connection (SQLite default for zero-config local run; switchable to PostgreSQL)
DATABASE_URL="file:./dev.db"

# JWT Auth Secret
JWT_SECRET="gharkatiffin_secure_jwt_token_secret_key_2026_hyperlocal"

# Public App Config
NEXT_PUBLIC_APP_NAME="GharKaTiffin"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Service Abstraction Drivers: 'mock' | 's3' | 'google' | 'razorpay'
STORAGE_DRIVER="mock"
MAPS_DRIVER="mock"
PAYMENT_DRIVER="mock"
NOTIFICATION_DRIVER="mock"

# Optional Cloud Credentials Placeholders
STORAGE_URL="https://s3.ap-south-1.amazonaws.com/gharkatiffin-assets"
MAPS_API_KEY=""
PAYMENT_API_KEY=""
EMAIL_API_KEY=""
SMS_API_KEY=""
